+/**
+* vim: set ts=4 :
+* =============================================================================
+* SourceMod Console Debugger Extension
+* Copyright (C) 2018-2021 Peace-Maker  All rights reserved.
+* =============================================================================
+*
+* Shared helpers to reach into VM internals that are not (yet) exposed to
+* extensions. Originally these lived inline in commands.cpp; they are factored
+* out here so both the console-mode `frame` command and the DAP handlers can
+* reuse the exact same (necessarily fragile) logic from a single place.
+*
+* WARNING: The layout assumptions below depend on the SourcePawn VM version
+* (the peace-maker/sourcepawn:debug_api_symbols fork). If frame selection
+* breaks after a VM update, this is the single file to adjust.
+*/
+#ifndef _INCLUDE_DEBUGGER_FRAME_UTILS_H
+#define _INCLUDE_DEBUGGER_FRAME_UTILS_H
+
+#include <sp_vm_api.h>
+#include "plugin-debug-info.h"
+#include "vm-hooks.h"
+#include <memory>
+#include <cstdint>
+
+namespace sp {
+
+// Hack to access data in the VM currently not exposed to extensions.
+// Highly depends on the VM version.
+// TODO: Find a way to safely expose this "implementation detail".
+class InlineFrameIterator
+{
+public:
+  virtual ~InlineFrameIterator()
+  {}
+
+  // "done" should return true if, after the current frame, there are no more
+  // frames to iterate.
+  virtual bool done() const = 0;
+  virtual void next() = 0;
+  virtual int type() const = 0;
+#if !defined(SPDBG_MERGED_ENV_API)
+  // SourceMod 1.12 (and the old patched VM) have this slot; SourcePawn 2.0
+  // (SourceMod 1.13) does not -- declaring it there would shift cip() onto
+  // native_index() in the vtable.
+  virtual cell_t function_cip() const = 0;
+#endif
+  virtual cell_t cip() const = 0;
+  virtual uint32_t native_index() const = 0;
+};
+
+class FrameIteratorHack
+{
+public:
+  virtual void somefunc() = 0;
+  void* ivk_;
+  void* runtime_;
+  intptr_t* next_exit_fp_;
+  std::unique_ptr<InlineFrameIterator> frame_cursor_;
+};
+
+// Read the current (top) frame pointer of a plugin context by reaching into
+// the BaseContext layout. Mirrors the offset math used by the console `frame`
+// command. Kept in one spot so the magic offset is only written once.
+// TODO: Properly expose this from the VM :D
+inline cell_t ReadContextFramePointer(SourcePawn::IPluginContext* ctx)
+{
+#if defined(SPDBG_MERGED_ENV_API)
+  // SourcePawn 2.0 merged IPluginContext into the runtime, so the old offset
+  // into BaseContext is gone and GetLocalParams() is no longer public. Only
+  // legacy (v1) plugins have debug info we can read, so a plugin with none is
+  // either v2 or unreadable and there is no frame to recover.
+  SpPluginDebugInfo* info = SpDebugInfo(ctx->GetRuntime());
+  if (!info)
+    return 0;
+  if (info->IsV2()) {
+    // SourcePawn 2.0 plugin: registers live in the plugin heap; the interpreter
+    // that owns them is found on this (VM) thread's stack.
+    std::vector<cell_t> frames;
+    if (!spdbg::vm::InterpreterFrames(ctx->GetRuntime(), false, &frames) || frames.empty())
+      return 0;
+    return frames[0];
+  }
+
+  // LocalParams() is frm + 2 cells as a host pointer; local address 0 is the
+  // plugin's memory base, so the difference is frm.
+  cell_t* params = spdbg::vm::LocalParams(ctx->GetRuntime());
+  cell_t* base = nullptr;
+  if (!params || ctx->LocalToPhysAddr(0, &base) != SP_ERROR_NONE || !base)
+    return 0;
+  return cell_t(reinterpret_cast<uintptr_t>(params) - reinterpret_cast<uintptr_t>(base)) -
+         cell_t(2 * sizeof(cell_t));
+#else
+  return *(cell_t*)(uintptr_t(ctx) + sizeof(void*) * 10 + sizeof(bool) * 4 +
+                    sizeof(uint32_t) * 2 + sizeof(cell_t) * 3);
+#endif
+}
+
+} // namespace sp
+
+#endif // _INCLUDE_DEBUGGER_FRAME_UTILS_H
