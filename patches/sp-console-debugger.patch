index 0000000..12a4b36
--- /dev/null
+++ b/tests/pty_run.py
@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+"""Run a command on a pty, feed it this script's stdin, echo what it printed.
+
+The debugger only opens its interactive `dbg>` prompt when stdin is a terminal:
+on a headless server with a piped stdin it resumes execution instead (otherwise
+`std::getline(std::cin)` on a non-tty would freeze the game server -- see
+Debugger::HandleInput). The console regression suite therefore cannot drive
+srcds through a plain heredoc; it needs a pty in between, which is all this
+does.
+
+Stopping is marker-driven rather than EOF-driven: srcds has no "quit on EOF"
+once it is talking to a terminal, so waiting for it to exit would mean waiting
+out a timeout on every run. --until is the last line the suite cares about;
+once it shows up (plus a short drain for whatever trails it) the child is
+killed and its output printed.
+
+Usage: pty_run.py [--until MARKER] [--timeout SECONDS] -- <command> [args...]
+"""
+import argparse
+import os
+import pty
+import select
+import subprocess
+import sys
+import time
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--until', dest='marker', default=None,
+                    help='stop once this text has been printed')
+parser.add_argument('--timeout', type=float, default=180.0,
+                    help='give up after this many seconds (default: 180)')
+parser.add_argument('command', nargs=argparse.REMAINDER)
+args = parser.parse_args()
+
+command = args.command[1:] if args.command[:1] == ['--'] else args.command
+if not command:
+    parser.error('no command given')
+
+commands = sys.stdin.buffer.read()
+marker = args.marker.encode() if args.marker else None
+
+master, slave = pty.openpty()
+proc = subprocess.Popen(command, stdin=slave, stdout=slave, stderr=slave, close_fds=True)
+os.close(slave)
+os.write(master, commands)
+
+output = bytearray()
+deadline = time.monotonic() + args.timeout
+seen_marker = False
+while time.monotonic() < deadline:
+    readable, _, _ = select.select([master], [], [], 0.25)
+    if readable:
+        try:
+            chunk = os.read(master, 65536)
+        except OSError:  # the child closed the pty
+            break
+        if not chunk:
+            break
+        output += chunk
+        if marker and not seen_marker and marker in output:
+            # Drain briefly so the marker's own line (and anything the server
+            # prints right behind it) lands in the captured output too.
+            seen_marker = True
+            deadline = time.monotonic() + 1.0
+    elif proc.poll() is not None:
+        break
+
+os.close(master)
+if proc.poll() is None:
+    proc.kill()
+proc.wait()
+
+# The pty turns every "\n" into "\r\n"; undo that so the captured text can be
+# compared against the plain golden files.
+sys.stdout.buffer.write(bytes(output).replace(b'\r\n', b'\n'))
+sys.exit(0 if (marker is None or seen_marker) else 1)
