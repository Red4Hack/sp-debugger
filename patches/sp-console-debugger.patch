+
+std::string
+Debugger::ExecuteReplCommand(const std::string& raw_line)
+{
+  std::string line = raw_line;
+  trimString(line);
+  if (line.empty())
+    return "";
+
+  // Split into command + params exactly like the interactive console loop.
+  std::string command, params;
+  size_t pos = line.find_first_of(" ");
+  if (pos == std::string::npos) {
+    command = line;
+  } else {
+    command = line.substr(0, pos);
+    params = line.substr(pos + 1);
+    trimString(params);
+  }
+
+  // Refuse execution-control commands: resuming/stepping must go through the
+  // DAP request path (continue/next/stepIn/stepOut) so the adapter emits the
+  // matching continued/stopped events and keeps its state in sync. Running them
+  // here would resume the VM behind the adapter's back.
+  std::string lower = command;
+  for (char& c : lower) c = static_cast<char>(tolower((unsigned char)c));
+  static const char* kBlocked[] = {
+    "continue", "c", "next", "n", "step", "s", "finish", "stepout",
+    "quit", "q", "exit"
+  };
+  for (const char* b : kBlocked) {
+    if (lower == b)
+      return "Use the debug toolbar (Continue/Step Over/Step Into/Step Out) for "
+             "execution control -- running \"" + command + "\" from the console "
+             "would desync the debugger. Inspection commands (bt, p <var>, x, "
+             "files, funcs, watch, ?) work here.";
+  }
+
+  // Capture everything written to stdout (std::cout AND printf/fputs all go to
+  // fd 1) while the command runs, by redirecting fd 1 to a pipe. The VM is
+  // parked at a breakpoint and the game's main thread is blocked, so concurrent
+  // stdout is minimal during this short window.
+#ifdef KE_POSIX
+  std::cout.flush();
+  fflush(stdout);
+
+  int pipefd[2];
+  int saved_stdout = -1;
+  bool capturing = false;
+  if (pipe(pipefd) == 0) {
+    saved_stdout = dup(STDOUT_FILENO);
+    if (saved_stdout != -1 && dup2(pipefd[1], STDOUT_FILENO) != -1) {
+      // Non-blocking read end so draining can't deadlock if nothing was written.
+      int flags = fcntl(pipefd[0], F_GETFL, 0);
+      fcntl(pipefd[0], F_SETFL, flags | O_NONBLOCK);
+      capturing = true;
+    }
+    close(pipefd[1]); // the write end is now duped onto fd 1
+  }
+
+  // Run the command (or help), mirroring the console loop's dispatch.
+  if (command == "?" || command == "help") {
+    ListCommands(params);
+  } else {
+    std::shared_ptr<DebuggerCommand> matched_cmd = ResolveCommandString(command);
+    if (matched_cmd)
+      matched_cmd->Accept(command, params);
+  }
+
+  std::string output;
+  if (capturing) {
+    std::cout.flush();
+    fflush(stdout);
+    // Restore fd 1 before draining so we don't capture our own reads.
+    dup2(saved_stdout, STDOUT_FILENO);
+    close(saved_stdout);
+
+    char buf[4096];
+    ssize_t n;
+    while ((n = read(pipefd[0], buf, sizeof(buf))) > 0) {
+      output.append(buf, n);
+      if (output.size() > 64 * 1024) // cap pathological output
+        break;
+    }
+    close(pipefd[0]);
+  }
+  return output;
+#else
+  // Non-POSIX: stdout-fd capture not implemented; run without capture.
+  if (command == "?" || command == "help") {
+    ListCommands(params);
+  } else {
+    std::shared_ptr<DebuggerCommand> matched_cmd = ResolveCommandString(command);
+    if (matched_cmd)
+      matched_cmd->Accept(command, params);
+  }
+  return "";
+#endif
+}
