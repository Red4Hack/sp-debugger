{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug sp-console-debugger (with build)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/objdir/package/addons/sourcemod/extensions/sp-debugger.ext.so",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "9. Build Extension",
      "miDebuggerPath": "/usr/bin/gdb"
    },
    {
      "name": "Debug sp-console-debugger (skip build)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/objdir/package/addons/sourcemod/extensions/sp-debugger.ext.so",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "miDebuggerPath": "/usr/bin/gdb"
    },
    {
      "name": "Debug sp-console-debugger (force clean build)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/objdir/package/addons/sourcemod/extensions/sp-debugger.ext.so",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Quick Rebuild (Both Architectures)",
      "miDebuggerPath": "/usr/bin/gdb"
    },
    {
      "name": "Debug Extension with Yarn Watch",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/vscode/node_modules/.bin/tsc",
      "args": ["-watch", "-p", "${workspaceFolder}/vscode"],
      "cwd": "${workspaceFolder}/vscode",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/vscode/out/**/*.js"],
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "watch:extension"
    },
    {
      "name": "Debug VSCode Extension (Extension Host)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode"
      ],
      "outFiles": ["${workspaceFolder}/vscode/out/**/*.js"],
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "compile:extension",
      "presentation": {
        "hidden": false,
        "group": "Extension Debug",
        "order": 1
      }
    },
    {
      "name": "Debug VSCode Extension with Watch",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode",
      ],
      "outFiles": ["${workspaceFolder}/vscode/out/**/*.js"],
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "watch:extension",
      "presentation": {
        "hidden": false,
        "group": "Extension Debug",
        "order": 2
      }
    },
    {
      "name": "Debug Extension Isolated",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/vscode/out/**/*.js"],
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "watch:extension (debug mode)",
      "presentation": {
        "hidden": false,
        "group": "Extension Debug"
      }
    }
  ]
}
