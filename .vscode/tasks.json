{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "presentation": {
    "reveal": "always",
    "panel": "shared",
    "clear": false
  },
  "inputs": [
    {
      "id": "sm112",
      "type": "promptString",
      "description": "SourceMod 1.12 source tree",
      "default": "${workspaceFolder}/../sourcemod-1.12"
    },
    {
      "id": "sm113",
      "type": "promptString",
      "description": "SourceMod 1.13 source tree",
      "default": "${workspaceFolder}/../sourcemod-1.13"
    }
  ],
  "tasks": [
    {
      "label": "Setup: venv + ambuild",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install --upgrade pip wheel setuptools git+https://github.com/alliedmodders/ambuild",
      "problemMatcher": []
    },
    {
      "label": "Fetch debugger source (upstream + patch)",
      "detail": "Rebuilds sp-console-debugger/ from the pinned upstream commit + patches/sp-console-debugger.patch. No-op if present.",
      "type": "shell",
      "command": "test -f sp-console-debugger/frame-utils.h && echo 'already present' || (sha=$(cat patches/sp-console-debugger.commit) && git init sp-console-debugger && git -C sp-console-debugger fetch --depth 1 https://github.com/peace-maker/sp-console-debugger \"$sha\" && git -C sp-console-debugger reset --hard FETCH_HEAD && git -C sp-console-debugger apply --whitespace=nowarn ../patches/sp-console-debugger.patch)",
      "problemMatcher": []
    },
    {
      "label": "Build: SourceMod 1.12",
      "detail": "One package per SourceMod line (the extension API differs: 8 vs 11).",
      "type": "shell",
      "command": "mkdir -p objdir-sm112 && cd objdir-sm112 && ../.venv/bin/python ../configure.py --enable-optimize --targets=x86,x86_64 --sm-path=\"${input:sm112}\" && ../.venv/bin/ambuild",
      "dependsOn": [
        "Fetch debugger source (upstream + patch)"
      ],
      "group": "build",
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Build: SourceMod 1.13",
      "type": "shell",
      "command": "mkdir -p objdir-sm113 && cd objdir-sm113 && ../.venv/bin/python ../configure.py --enable-optimize --targets=x86,x86_64 --sm-path=\"${input:sm113}\" && ../.venv/bin/ambuild",
      "dependsOn": [
        "Fetch debugger source (upstream + patch)"
      ],
      "group": "build",
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Build: both SourceMod lines",
      "dependsOn": [
        "Build: SourceMod 1.12",
        "Build: SourceMod 1.13"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Extension: compile",
      "type": "shell",
      "command": "bun run compile",
      "options": {
        "cwd": "${workspaceFolder}/vscode"
      },
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Extension: watch",
      "type": "shell",
      "command": "bun run watch:start",
      "options": {
        "cwd": "${workspaceFolder}/vscode",
        "env": {
          "NODE_ENV": "development"
        }
      },
      "isBackground": true,
      "problemMatcher": "$tsc-watch"
    },
    {
      "label": "Test: extension unit tests",
      "type": "shell",
      "command": "bun test src/__tests__/perf src/__tests__/profiler src/__tests__/utils src/__tests__/adapters src/__tests__/connections src/__tests__/extension.test.ts src/__tests__/debugAdapter.test.ts src/__tests__/ConfigValidator.test.ts src/__tests__/output-formatting.test.ts",
      "options": {
        "cwd": "${workspaceFolder}/vscode"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}